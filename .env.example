# ai2live environment example — copy to .env and fill values.
# Never commit real secrets. Doctor/CLI only report whether keys are set.

# Active model provider: grok | openai | codex
AI2LIVE_MODEL_PROVIDER=grok

# Deterministic mocks (no network). Use in CI / local smoke.
# AI2LIVE_MODEL_DRY_RUN=1

# HTTP client (OpenAI-compat chat + images)
# AI2LIVE_HTTP_TIMEOUT_MS=60000
# AI2LIVE_HTTP_MAX_RETRIES=2

# --- Grok / xAI ---
# AI2LIVE_GROK_API_KEY=
# XAI_API_KEY=
# AI2LIVE_GROK_BASE_URL=https://api.x.ai/v1
# AI2LIVE_GROK_MODEL=grok-2-latest
# AI2LIVE_GROK_IMAGE_MODEL=grok-2-latest

# --- OpenAI ---
# AI2LIVE_OPENAI_API_KEY=
# OPENAI_API_KEY=
# AI2LIVE_OPENAI_BASE_URL=https://api.openai.com/v1
# AI2LIVE_OPENAI_MODEL=gpt-4o
# AI2LIVE_OPENAI_IMAGE_MODEL=dall-e-2

# --- Codex (local CLI) ---
# AI2LIVE_CODEX_BIN=codex
# AI2LIVE_CODEX_ARGS=["--sandbox","read-only"]
# AI2LIVE_CODEX_CWD=
# AI2LIVE_CODEX_TIMEOUT_MS=120000

# Optional Python image worker (see services/image-worker-python)
# AI2LIVE_IMAGE_WORKER_URL=http://127.0.0.1:8090

# Opt-in live API integration test (skipped by default)
# AI2LIVE_LIVE_API_TEST=1

# Optional AutoLive2d / psd2live external binaries (never vendored)
# AI2LIVE_AUTOLIVE2D_CMD=autolive2d
# AI2LIVE_AUTOLIVE2D_BIN=
# AI2LIVE_PSD2LIVE_CMD=psd2live
# AI2LIVE_PSD2LIVE_BIN=
# AI2LIVE_PSD2LIVE_MCP_URL=http://127.0.0.1:8765/mcp

# Mock rig runtime (pose warp + downstream mock runners). Default on in tests/evals.
# AI2LIVE_USE_MOCK_RIG=1
# Force live VLM review when keys present (overrides dry-run for vision-review only when set)
# AI2LIVE_VLM_LIVE=1
